<Page x:Class="Alaloa.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Alaloa"
      Background="Black"
      IsTabStop="True">
  <!-- Three-layer composition (same pattern as the other neon demos):
       1. BackgroundSurface fills the window with deep-space backdrop + ambient
          drifting starfield.
       2. Viewbox constrains the GameSurface to the world's 720×720 SQUARE
          aspect — the light-cycle arena is a 90×90 grid (8px cells).
       3. Renderer draws the playfield over the top, framed by a thin neon
          rectangle. -->
  <Grid Background="Black">
    <local:BackgroundSurface x:Name="BackgroundCanvas"
                             IsHitTestVisible="False" />
    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
      <local:GameSurface x:Name="GameCanvas"
                         IsTabStop="False"
                         Width="720"
                         Height="720" />
    </Viewbox>
  </Grid>
</Page>
