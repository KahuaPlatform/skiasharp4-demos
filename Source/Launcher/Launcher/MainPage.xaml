<Page x:Class="Launcher.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Launcher"
      Background="Black"
      IsTabStop="True">
  <!-- Three-layer composition (matches the game demos for visual consistency):
       1. BackgroundSurface fills the window with the deep-space gradient +
          drifting starfield. Tied to PointerEvents=false so it never intercepts
          clicks meant for the card grid above.
       2. Viewbox constrains the catalog canvas to the world's 1280x720 (16:9)
          landscape aspect.
       3. GameSurface renders the card grid and chrome (rainbow title, gloss
          marquee, hover tooltip) and receives pointer events for card clicks. -->
  <Grid Background="Black">
    <local:BackgroundSurface x:Name="BackgroundCanvas"
                             IsHitTestVisible="False" />
    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
      <local:GameSurface x:Name="GameCanvas"
                         IsTabStop="False"
                         Width="1280"
                         Height="720" />
    </Viewbox>
  </Grid>
</Page>
