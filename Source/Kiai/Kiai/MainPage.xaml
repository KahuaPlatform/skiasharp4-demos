<Page x:Class="Kiai.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Kiai"
      Background="Black"
      IsTabStop="True">
  <!-- Pohaku-style stretched layout (NO Viewbox): the world is not scaled to
       fit; the Camera2D performs all framing. Two stretched layers:
         1. BackgroundSurface — deep-space gradient + drifting starfield, fills
            the whole window so the radar strip's empty sky reads as space.
         2. GameSurface — the playfield; the Renderer scrolls/wraps the world
            inside it via the camera, so it must fill the window 1:1 in pixels. -->
  <Grid Background="Black">
    <local:BackgroundSurface x:Name="BackgroundCanvas"
                             IsHitTestVisible="False" />
    <local:GameSurface x:Name="GameCanvas"
                       IsTabStop="False"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
  </Grid>
</Page>
