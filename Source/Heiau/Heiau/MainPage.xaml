<Page x:Class="Heiau.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Heiau"
      Background="Black"
      IsTabStop="True">
  <!-- Three-layer composition (same pattern as Lua/HokuLele/Mahina):
       1. BackgroundSurface fills the window with deep-space backdrop + ambient
          drifting starfield.
       2. Viewbox constrains the GameSurface to the world's 900×900 SQUARE
          aspect so the radial action stays centred at any window size.
       3. Renderer draws the playfield over the top, framed by a thin neon
          rectangle. -->
  <Grid Background="Black">
    <local:BackgroundSurface x:Name="BackgroundCanvas"
                             IsHitTestVisible="False" />
    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
      <local:GameSurface x:Name="GameCanvas"
                         IsTabStop="False"
                         Width="900"
                         Height="900" />
    </Viewbox>
  </Grid>
</Page>
