<Page x:Class="Mahina.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Mahina"
      Background="Black"
      IsTabStop="True">
  <!-- Three-layer composition (same pattern as Lua/HokuLele):
       1. BackgroundSurface fills the whole window with the deep-space backdrop +
          ambient drifting starfield. Side bars become "the rest of space".
       2. Viewbox constrains the GameSurface to the world's 1280×720 landscape
          aspect, scaling to fit while preserving 16:9.
       3. Renderer draws the playfield over the top, framed by a thin neon
          rectangle so the gameplay area reads as distinct from the bars. -->
  <Grid Background="Black">
    <local:BackgroundSurface x:Name="BackgroundCanvas"
                             IsHitTestVisible="False" />
    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
      <local:GameSurface x:Name="GameCanvas"
                         IsTabStop="False"
                         Width="1280"
                         Height="720" />
    </Viewbox>
  </Grid>
</Page>
