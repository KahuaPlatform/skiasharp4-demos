<Page x:Class="Uno3dViewer.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Uno3dViewer"
      xmlns:rendering="using:Uno3dViewer.Rendering"
      Background="#0B141F"
      KeyDown="Page_KeyDown"
      KeyUp="Page_KeyUp">

  <Page.Resources>
    <SolidColorBrush x:Key="ToolbarBg" Color="#1B2C4A" />
    <SolidColorBrush x:Key="ToolbarActive" Color="#2962FF" />
    <SolidColorBrush x:Key="ToolbarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarSeparator" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ToolbarTransparent" Color="Transparent" />
    <SolidColorBrush x:Key="ToolbarReadoutBg" Color="#0F1D34" />

    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Bg.Background" Value="#332A3F62" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Bg.Background" Value="#552A3F62" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid>
    <rendering:ModelViewerGlCanvasElement x:Name="Viewer"
                                          IsTabStop="True"
                                          PointerPressed="Viewer_PointerPressed"
                                          PointerMoved="Viewer_PointerMoved"
                                          PointerReleased="Viewer_PointerReleased"
                                          PointerCaptureLost="Viewer_PointerCaptureLost"
                                          PointerWheelChanged="Viewer_PointerWheelChanged"
                                          PointerEntered="Viewer_PointerEntered" />

    <Border HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Background="{StaticResource ToolbarBg}"
            CornerRadius="8"
            Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="2">

        <Button x:Name="OrbitBtn"
                Style="{StaticResource ToolbarButton}"
                Click="Orbit_Click"
                ToolTipService.ToolTip="Orbit mode">
          <FontIcon Glyph="&#xE89F;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="16" />
        </Button>
        <Button x:Name="WalkBtn"
                Style="{StaticResource ToolbarButton}"
                Click="Walk_Click"
                ToolTipService.ToolTip="Walk mode (WASD, right-drag to look)">
          <FontIcon Glyph="&#xE805;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="16" />
        </Button>

        <Border Width="1" Background="{StaticResource ToolbarSeparator}" Margin="6,4" />

        <Button Style="{StaticResource ToolbarButton}"
                Click="Open_Click"
                ToolTipService.ToolTip="Open model file">
          <FontIcon Glyph="&#xE8E5;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="16" />
        </Button>

        <Border Width="1" Background="{StaticResource ToolbarSeparator}" Margin="6,4" />

        <Button Style="{StaticResource ToolbarButton}" Click="ViewTop_Click" ToolTipService.ToolTip="Top view">
          <TextBlock Text="T" FontSize="13" FontWeight="SemiBold" Foreground="White" />
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Click="ViewFront_Click" ToolTipService.ToolTip="Front view">
          <TextBlock Text="F" FontSize="13" FontWeight="SemiBold" Foreground="White" />
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Click="ViewRight_Click" ToolTipService.ToolTip="Right view">
          <TextBlock Text="R" FontSize="13" FontWeight="SemiBold" Foreground="White" />
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Click="ViewIso_Click" ToolTipService.ToolTip="Isometric view">
          <TextBlock Text="Iso" FontSize="11" FontWeight="SemiBold" Foreground="White" />
        </Button>

        <Border Width="1" Background="{StaticResource ToolbarSeparator}" Margin="6,4" />

        <Border Background="{StaticResource ToolbarReadoutBg}"
                CornerRadius="4"
                Padding="10,0"
                MinWidth="64"
                Height="28"
                VerticalAlignment="Center">
          <TextBlock x:Name="ZoomText"
                     Text="100%"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="12" />
        </Border>

        <Border Width="1" Background="{StaticResource ToolbarSeparator}" Margin="6,4" />

        <Button Style="{StaticResource ToolbarButton}" Click="Fit_Click" ToolTipService.ToolTip="Fit to view">
          <FontIcon Glyph="&#xE9A6;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="16" />
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Click="Reset_Click" ToolTipService.ToolTip="Reset view">
          <FontIcon Glyph="&#xE72C;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="16" />
        </Button>

        <Border Width="1" Background="{StaticResource ToolbarSeparator}" Margin="6,4" />

        <Button x:Name="DemoBtn"
                Style="{StaticResource ToolbarButton}"
                Click="Demo_Click"
                ToolTipService.ToolTip="Demo mode (auto-rotate)">
          <FontIcon Glyph="&#xE768;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="16" />
        </Button>

      </StackPanel>
    </Border>
  </Grid>
</Page>
