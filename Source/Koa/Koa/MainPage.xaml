<Page x:Class="Koa.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Koa"
      Background="Black"
      IsTabStop="True">
  <!-- Pohaku-style stretched layout (NOT a Viewbox): the shared Camera2D, not a
       scale-to-fit Viewbox, performs framing. Two stretched layers:
         1. BackgroundSurface — crypt-dark gradient + drifting torch-dust stars.
         2. GameSurface — the scrolling dungeon, drawn under the camera transform. -->
  <Grid Background="Black">
    <local:BackgroundSurface x:Name="BackgroundCanvas"
                             IsHitTestVisible="False" />
    <local:GameSurface x:Name="GameCanvas"
                       IsTabStop="False"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
  </Grid>
</Page>
