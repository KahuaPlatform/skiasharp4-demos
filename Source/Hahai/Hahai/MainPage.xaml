<Page x:Class="Hahai.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Hahai"
      Background="Black"
      IsTabStop="True">
  <!-- Three-layer composition (same pattern as the other neon demos):
       1. BackgroundSurface fills the window with deep-space backdrop + ambient
          drifting starfield.
       2. Viewbox constrains the GameSurface to the maze's 672×744 aspect —
          28×31 cells at 24px each, the canonical Pac-Man footprint.
       3. Renderer draws the playfield over the top, framed by neon walls. -->
  <Grid Background="Black">
    <local:BackgroundSurface x:Name="BackgroundCanvas"
                             IsHitTestVisible="False" />
    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
      <!-- Surface is 50px taller top and bottom than the maze (672×744) so the
           HUD (score/lives/marquee) gets its own band instead of sitting on
           top of the playfield. -->
      <local:GameSurface x:Name="GameCanvas"
                         IsTabStop="False"
                         Width="672"
                         Height="844" />
    </Viewbox>
  </Grid>
</Page>
