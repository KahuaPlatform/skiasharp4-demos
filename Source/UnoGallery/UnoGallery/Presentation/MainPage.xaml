<Page x:Class="UnoGallery.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoGallery.Presentation"
      xmlns:scene="using:UnoGallery.Scene"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="Black">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
  </Page.KeyboardAccelerators>
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <scene:GallerySurface x:Name="Surface" />

    <Border VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Padding="20,12"
            Background="#80000000">
      <Grid>
        <TextBlock Text="UnoGallery — SkiaSharp 4 + Uno Platform"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontWeight="SemiBold"
                   FontSize="14" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button x:Name="GridBtn"
                  Content="Grid"
                  Click="OnGridClick"
                  Padding="14,4"
                  Background="#33FFFFFF"
                  Foreground="White"
                  BorderThickness="0" />
          <Button x:Name="HelixBtn"
                  Content="Helix"
                  Click="OnHelixClick"
                  Padding="14,4"
                  Background="#11FFFFFF"
                  Foreground="White"
                  BorderThickness="0" />
          <Button x:Name="CarouselBtn"
                  Content="Carousel"
                  Click="OnCarouselClick"
                  Padding="14,4"
                  Background="#11FFFFFF"
                  Foreground="White"
                  BorderThickness="0" />
          <Button x:Name="OpenFolderBtn"
                  Content="Open folder…"
                  Click="OnOpenFolderClick"
                  Padding="14,4"
                  Background="#11FFFFFF"
                  Foreground="White"
                  BorderThickness="0" />
          <Button x:Name="DemoBtn"
                  Content="Demo: on"
                  Click="OnDemoClick"
                  Padding="14,4"
                  Background="#33FFFFFF"
                  Foreground="White"
                  BorderThickness="0" />
          <Button x:Name="SettingsBtn"
                  Content="⚙"
                  Padding="14,4"
                  Background="#11FFFFFF"
                  Foreground="White"
                  BorderThickness="0">
            <Button.Flyout>
              <Flyout x:Name="SettingsFlyout">
                <ScrollViewer MaxHeight="500"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Orientation="Vertical" Spacing="10" MinWidth="240">
                  <TextBlock Text="Audio source"
                             FontWeight="SemiBold"
                             FontSize="14"
                             Margin="0,0,0,4" />
                  <ComboBox x:Name="AudioSourceCombo"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnAudioSourceChanged" />
                  <TextBlock Text="Effects"
                             FontWeight="SemiBold"
                             FontSize="14"
                             Margin="0,8,0,4" />
                  <ToggleSwitch x:Name="AmbientToggle"
                                Header="Ambient background"
                                IsOn="True"
                                Toggled="OnAmbientToggled" />
                  <ToggleSwitch x:Name="BloomToggle"
                                Header="Bloom"
                                IsOn="True"
                                Toggled="OnBloomToggled" />
                  <ToggleSwitch x:Name="VignetteToggle"
                                Header="Vignette"
                                IsOn="True"
                                Toggled="OnVignetteToggled" />
                  <ToggleSwitch x:Name="GrainToggle"
                                Header="Film grain"
                                IsOn="True"
                                Toggled="OnGrainToggled" />
                  <ToggleSwitch x:Name="ChromaToggle"
                                Header="Chromatic aberration"
                                IsOn="True"
                                Toggled="OnChromaToggled" />
                  <ToggleSwitch x:Name="HoverGlowToggle"
                                Header="Hover glow"
                                IsOn="True"
                                Toggled="OnHoverGlowToggled" />
                  <ToggleSwitch x:Name="DissolveToggle"
                                Header="Dissolve transitions"
                                IsOn="True"
                                Toggled="OnDissolveToggled" />
                  <ToggleSwitch x:Name="IrisToggle"
                                Header="Iris (Detail) transition"
                                IsOn="True"
                                Toggled="OnIrisToggled" />
                  <ToggleSwitch x:Name="ProfilerToggle"
                                Header="Frame profiler overlay"
                                IsOn="False"
                                Toggled="OnProfilerToggled" />
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
