// Noise-threshold dissolve between two scenes. Each pixel has a fixed
// threshold pulled from a 2D value-noise field; as progress rises, more
// pixels cross their threshold and switch from iSrcA to iSrcB. The result
// is a "tiles vanish from one arrangement, materialise into the other"
// effect that's distinct from a straight cross-fade.
//
// Uniforms:
//   iProgress    0..1, eased outside
//   iNoiseScale  pixel size of one noise tile (larger = chunkier dissolve)
// Children:
//   iSrcA        outgoing scene
//   iSrcB        incoming scene

uniform float  iProgress;
uniform float  iNoiseScale;
uniform shader iSrcA;
uniform shader iSrcB;

float hash(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float vnoise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float a = hash(i);
    float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0));
    float d = hash(i + float2(1.0, 1.0));
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

half4 main(float2 fragCoord) {
    half4 a = iSrcA.eval(fragCoord);
    half4 b = iSrcB.eval(fragCoord);

    // Two octaves of value noise — more interesting than single-octave thresholding.
    float n = 0.65 * vnoise(fragCoord / iNoiseScale)
            + 0.35 * vnoise(fragCoord / (iNoiseScale * 0.45));

    // Feathered edge so the dissolve has a glowing transition band.
    float feather = 0.08;
    float w = smoothstep(n - feather, n + feather, iProgress);

    return mix(a, b, w);
}
