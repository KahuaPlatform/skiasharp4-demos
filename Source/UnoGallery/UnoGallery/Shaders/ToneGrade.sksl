// Cinematic tone grade as an SKSL color filter.
//
// Lifts shadows toward teal, pushes highlights toward warm orange, slightly
// raises overall saturation. Pure per-pixel function with NO uniforms — that's
// deliberate, to dodge SkiaSharp 4.147.0-preview.3.1's broken uniform-table
// path (`sk_runtimeeffect_get_uniform_byte_size`).
//
// Entry: half4 main(half4 c)

half4 main(half4 c) {
    half3 col = c.rgb;

    // Luma for shaping the curve.
    half luma = dot(col, half3(0.299, 0.587, 0.114));

    // Shadows: blend toward a cool teal as luma drops.
    half shadow_mix = smoothstep(0.55, 0.0, luma);
    half3 shadow_tint = half3(0.0, 0.55, 0.65);
    col = mix(col, mix(col, shadow_tint, 0.30), shadow_mix);

    // Highlights: warm orange lift as luma rises.
    half highlight_mix = smoothstep(0.55, 1.0, luma);
    half3 highlight_tint = half3(1.0, 0.78, 0.45);
    col = mix(col, mix(col, highlight_tint, 0.35), highlight_mix);

    // Mild saturation bump — push each channel away from luma by ~6 %.
    col = mix(half3(luma), col, 1.06);

    // Soft S-curve on luminance to add contrast without losing detail.
    half3 s = col * col * (3.0 - 2.0 * col);
    col = mix(col, s, 0.20);

    return half4(clamp(col, 0.0, 1.0), c.a);
}
