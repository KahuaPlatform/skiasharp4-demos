<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      SkiaSharp version. Default: 4.151.0 (SkiaSharp 4 stable). Build against the
      v3 line instead with:

        dotnet build -p:SkiaSharpVersion=3.119.4

      When the version begins with "4.", SKIA_V4 is defined so individual call
      sites can opt into v4-only APIs behind `#if SKIA_V4` while keeping a v3
      path intact. The property exists to keep that A/B capability, which is the
      point of this demo — not because either version is broken.

      History: the default used to be 3.119.4 because SkiaSharp
      4.147.0-preview.3.1 AV'd inside native sk_runtimeeffect_get_uniform_byte_size
      on the first SKRuntimeEffectUniforms construction, which cost five of the
      six SKSL effects. Re-tested on 4.151.0: all six compile, bind uniforms and
      child shaders, and render in the Uno host, so the gate that disabled them
      is gone and v4 is now the default. See DESIGN.md §2.2.
    -->
    <SkiaSharpVersion Condition="'$(SkiaSharpVersion)' == ''">4.151.0</SkiaSharpVersion>
    <DefineConstants Condition="$(SkiaSharpVersion.StartsWith('4.'))">$(DefineConstants);SKIA_V4</DefineConstants>

    <!--
      Adding NoWarn to remove build warnings
      NU1507: Warning when there are multiple package sources when using CPM with no source mapping
      NETSDK1201: Warning that specifying RID won't create self containing app
      PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>
  </PropertyGroup>
</Project>
